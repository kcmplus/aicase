[Unit]
Description=Push customer-paid orders to their selected supplier device
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/opt/aicase-prod/current/backend/management_api/management/commands/dispatch_supplier_orders.py
ConditionPathExists=!/var/lib/aicase-prod/deploying

[Service]
Type=oneshot
User=aicase-prod
Group=aicase-prod
WorkingDirectory=/opt/aicase-prod/current/backend
EnvironmentFile=/etc/aicase-prod/backend.env
ExecStart=/opt/aicase-prod/current/.venv/bin/python manage.py dispatch_supplier_orders
TimeoutStartSec=300
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
