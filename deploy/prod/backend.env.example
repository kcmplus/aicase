# Root-owned, chmod 600. Both bash and systemd read this file.
# Quote values containing spaces. Do not use shell substitutions.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=popomo.chunpat.cc
DJANGO_CSRF_TRUSTED_ORIGINS=https://popomo.chunpat.cc
DJANGO_TRUST_PROXY=1
DJANGO_MEDIA_ROOT=/var/lib/aicase-prod/media
POSTGRES_DB=aicase_prod
POSTGRES_USER=aicase_prod
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
AI_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AI_DAILY_RENDER_LIMIT=20
AI_CONCURRENT_RENDER_LIMIT=2

# Device order handoff. Merchant Authorization stays in the admin connection.
# Enable after saveOrder and free have been verified with the supplier.
SUPPLIER_ORDER_ENABLED=0
# Merchant self-payment records may release hardware; enable only for accepted integration.
SUPPLIER_PAYMENT_ENABLED=0
# status=4 is confirmed cancelled; dispensing is not customer collection.
# Confirmed 2026-11-10: 1 = success; other nonzero values stay unmapped.
SUPPLIER_ORDER_STATUS_MAP='{"print":{"0":"idle","1":"printed"},"shipment":{"0":"idle","1":"dispensed"}}'
SUPPLIER_ORDER_STATUS_VERIFIED=0
SUPPLIER_ORDER_PUBLIC_URL=https://popomo.chunpat.cc
