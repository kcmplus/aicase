# Root-owned, chmod 600. Both bash and systemd read this file.
# Quote values containing spaces. Do not use shell substitutions.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=popomo.chunpat.cc
DJANGO_CSRF_TRUSTED_ORIGINS=https://popomo.chunpat.cc
DJANGO_TRUST_PROXY=1
DJANGO_MEDIA_ROOT=/var/lib/aicase-prod/media
POSTGRES_DB=aicase_prod
POSTGRES_USER=aicase_prod
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
AI_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AI_DAILY_RENDER_LIMIT=20
AI_CONCURRENT_RENDER_LIMIT=2
