[Unit]
Description=POPOMO API
After=network.target

[Service]
User=aicase
Group=aicase
WorkingDirectory=/opt/aicase/backend
EnvironmentFile=/etc/aicase/backend.env
ExecStart=/opt/aicase/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --access-logfile - --error-logfile -
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
