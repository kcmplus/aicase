# In nginx http {} scope, once:
# limit_req_zone $binary_remote_addr zone=aicase_login:10m rate=10r/m;

# In existing HTTPS server {}. Example release contains storefront/ and admin/.
root /opt/aicase/web/current/storefront;
client_max_body_size 12m;

location = /admin { return 301 /admin/; }
location /admin/ {
    alias /opt/aicase/web/current/admin/;
    try_files $uri $uri/ /admin/index.html;
    add_header Cache-Control "no-cache";
}
location = /api/v1/auth/login/ {
    limit_req zone=aicase_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location ^~ /assets/optimized/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
}
location ^~ /media/previews/ {
    alias /opt/aicase/backend/media/previews/;
    autoindex off;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
}
location /media/ {
    alias /opt/aicase/backend/media/;
    add_header X-Content-Type-Options nosniff always;
    autoindex off;
}
location / { try_files $uri $uri/ /index.html; }
