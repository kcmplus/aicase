# Production example; copy privately and supply real values through your service manager.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=aicase.dinglh.cn
DJANGO_CSRF_TRUSTED_ORIGINS=https://aicase.dinglh.cn
# Set only when the trusted reverse proxy strips/replaces X-Forwarded-Proto.
DJANGO_TRUST_PROXY=1
DJANGO_MEDIA_ROOT=/var/lib/aicase/media
# Omit POSTGRES_DB for local SQLite. Use PostgreSQL for shared environments.
POSTGRES_DB=aicase
POSTGRES_USER=aicase
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
